# URL API yang dipanggil langsung oleh browser (opsional).
# Kosongkan di production/Vercel agar browser memakai proxy same-origin /api.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# URL backend untuk proxy /api/* di server Next.js (production/Vercel).
# Contoh: https://campusflow-api.example.com/api
API_URL=

# VAPID public key untuk browser push subscription
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
