# Server
PORT=3001

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://campusflow:campusflow@localhost:5432/campusflow

# Auth
JWT_SECRET=ganti-dengan-secret-panjang-di-produksi
JWT_REFRESH_SECRET=ganti-dengan-refresh-secret-panjang-di-produksi

# Redis (untuk Reminder engine / BullMQ)
REDIS_URL=redis://localhost:6379
# Atau pakai host/port terpisah:
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Interval sweep reminder (ms), default 60000
# REMINDER_SWEEP_MS=60000

# Web Push API (VAPID) — generate dengan: node scripts/generate-vapid.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@campusflow.local

# CORS
CORS_ORIGIN=http://localhost:3000