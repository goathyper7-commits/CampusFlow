generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MAHASISWA
  ADMIN
}

enum Prioritas {
  RENDAH
  SEDANG
  TINGGI
}

enum TaskStatus {
  BELUM_DIKERJAKAN
  DIKERJAKAN
  SELESAI
  TERLAMBAT
}

enum Hari {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
  MINGGU
}

enum ActivityKategori {
  ORGANISASI
  OLAHRAGA
  KERJA_KELOMPOK
  PRIBADI
}

enum GroupRole {
  KETUA
  ANGGOTA
}

enum ChannelType {
  TELEGRAM
  PUSH
  EMAIL
  IN_APP
}

enum OtpPurpose {
  REGISTER
  LOGIN_PERANGKAT_BARU
  LUPA_SANDI
  GANTI_USERNAME
  GANTI_NOMOR
}

enum ReminderStatus {
  SCHEDULED
  SENT
  CANCELLED
  SNOOZED
  FAILED
}

model User {
  id           String   @id @default(uuid())
  nim          String   @unique
  nama         String
  email        String   @unique
  passwordHash String
  prodi        String?
  semester     Int?
  role         Role     @default(MAHASISWA)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  phoneE164        String?   @unique
  phoneVerifiedAt  DateTime?
  username         String?   @unique
  usernameChangedAt DateTime?
  botEnabled       Boolean   @default(true)
  quietHoursStart  Int?
  quietHoursEnd    Int?

  courses              Course[]
  tasks                Task[]
  activities           Activity[]
  notifications        Notification[]
  groupMembers         GroupMember[]
  leadingGroups        TaskGroup[]
  assignedSubTasks     SubTask[]
  comments             Comment[]
  pushSubscriptions    PushSubscription[]
  notificationPreference NotificationPreference?
  reminders            Reminder[]
  auditLogs            AuditLog[]
  userChannels         UserChannel[]
  telegramLinkTokens   TelegramLinkToken[]
  otpCodes             OtpCode[]
  usernameHistory      UsernameHistory[]
}

model UsernameHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username  String
  changedAt DateTime @default(now())

  @@index([userId, changedAt])
}

model UserChannel {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel          ChannelType
  telegramChatId   String?     @unique
  telegramUsername String?
  optedIn          Boolean     @default(true)
  verifiedAt       DateTime?
  optedOutAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([userId, channel])
  @@index([channel, optedIn])
}

model TelegramLinkToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model OtpCode {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    OtpPurpose
  channel    ChannelType @default(TELEGRAM)
  expiresAt  DateTime
  attempts   Int        @default(0)
  maxAttempts Int       @default(5)
  usedAt     DateTime?
  sendCount  Int        @default(0)
  lastSentAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, purpose, createdAt])
}

model Course {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  kode       String
  namaMatkul String
  sks        Int
  dosen      String?
  schedules  Schedule[]
  tasks      Task[]

  @@index([userId])
}

model Schedule {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  hari        Hari
  jamMulai    String
  jamSelesai  String
  ruang       String?
  isRecurring Boolean  @default(true)

  @@index([courseId])
}

model Task {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  courseId    String?
  course      Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  judul       String
  deskripsi   String?
  deadline    DateTime
  prioritas   Prioritas    @default(SEDANG)
  status      TaskStatus   @default(BELUM_DIKERJAKAN)
  createdAt   DateTime     @default(now())

  subtasks    SubTask[]
  taskGroup   TaskGroup?
  reminders   Reminder[]
  comments    Comment[]
  attachments Attachment[]

  @@index([userId])
  @@index([courseId])
}

model SubTask {
  id         String  @id @default(uuid())
  taskId     String
  task       Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  judul      String
  isDone     Boolean @default(false)

  @@index([taskId])
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  isi       String
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([userId])
}

model TaskGroup {
  id      String        @id @default(uuid())
  taskId  String        @unique
  task    Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ketuaId String
  ketua   User          @relation(fields: [ketuaId], references: [id])
  members GroupMember[]
}

model GroupMember {
  id      String    @id @default(uuid())
  groupId String
  group   TaskGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User      @relation(fields: [userId], references: [id])
  role    GroupRole @default(ANGGOTA)

  @@index([groupId])
  @@index([userId])
}

model Activity {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  judul        String
  kategori     ActivityKategori
  lokasi       String?
  waktuMulai   DateTime
  waktuSelesai DateTime
  isRecurring  Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  reminders Reminder[]

  @@index([userId, waktuMulai])
}

model Reminder {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  eventId     String?
  event       Activity?      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  offsetMinutes Int
  scheduledAt DateTime
  status      ReminderStatus @default(SCHEDULED)
  isSent      Boolean        @default(false)
  sentAt      DateTime?
  snoozeCount Int            @default(0)
  cancelledAt DateTime?
  notifications Notification[]

  @@index([taskId])
  @@index([eventId])
  @@index([status, scheduledAt])
  @@index([isSent])
  @@index([scheduledAt])
}

model Notification {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  tipe          String
  channel       ChannelType @default(IN_APP)
  status        String    @default("QUEUED")
  pesan         String
  scheduledAt   DateTime
  isSent        Boolean   @default(false)
  isRead        Boolean   @default(false)
  sentAt        DateTime?
  error         String?
  providerMessageId String?
  createdAt     DateTime  @default(now())
  reminderId    String?
  reminder      Reminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
  @@index([reminderId])
  @@index([channel, status])
}

model NotificationPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  autoRemindersEnabled Boolean  @default(true)
  pushEnabled         Boolean  @default(true)
  telegramEnabled     Boolean  @default(true)
  createdAt           DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())

  @@index([userId])
}

model Attachment {
  id       String @id @default(uuid())
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileUrl  String
  fileType String
  fileSize Int

  @@index([taskId])
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  aksi      String
  detail    String
  createdAt DateTime @default(now())

  @@index([adminId])
}